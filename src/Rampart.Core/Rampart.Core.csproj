<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Rampart</RootNamespace>
    <AssemblyName>Rampart.Core</AssemblyName>
    <Description>Core PE transformation and inspection library for Rampart.</Description>
    <PackageTags>pe;obfuscation;protection;windows;x64</PackageTags>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    <PackageReference Include="Microsoft.ILVerification" Version="10.0.6" />
  </ItemGroup>

</Project>
