<Window x:Class="Rampart.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rampart"
        Icon="pack://application:,,,/Rampart.Gui;component/Assets/rampart.ico"
        Width="1160" Height="760"
        MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CanvasBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header bar -->
        <Border Grid.Row="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Vector rook mark mirrors the application icon at every display DPI. -->
                    <Viewbox Width="18" Height="18" Margin="0,0,9,0" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Fill="{StaticResource AccentBrush}"
                                  Data="M 5,4.2 L 8,4.2 L 8,7.2 L 10.4,7.2 L 10.4,4.2 L 13.6,4.2 L 13.6,7.2 L 16,7.2 L 16,4.2 L 19,4.2 L 19,9.6 L 16.9,11.4 L 17.7,17.4 L 19.1,17.4 L 19.6,19.8 L 4.4,19.8 L 4.9,17.4 L 6.3,17.4 L 7.1,11.4 L 5,9.6 Z" />
                            <Path Fill="#52081009"
                                  Data="M 12,4.2 L 13.6,4.2 L 13.6,7.2 L 16,7.2 L 16,4.2 L 19,4.2 L 19,9.6 L 16.9,11.4 L 17.7,17.4 L 19.1,17.4 L 19.6,19.8 L 12,19.8 Z" />
                            <Path Fill="{StaticResource SurfaceBrush}"
                                  Data="M 10.5,17.5 L 10.5,14 L 12,12.8 L 13.5,14 L 13.5,17.5 Z" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Rampart"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="WorkerStateDot"
                             Width="7" Height="7"
                             Fill="{StaticResource WarningBrush}"
                             Margin="0,0,8,0"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="WorkerStateText"
                               Text="CLI worker not found"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main split workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left sidebar: single surface separated into sections by hairline dividers -->
            <Border Grid.Column="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border BorderBrush="{StaticResource DividerBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="18,13">
                            <StackPanel>
                                <TextBlock Text="Input" Style="{StaticResource SectionTitle}" />
                                <Border x:Name="DropBorder"
                                        AllowDrop="True"
                                        Margin="0,8,0,0"
                                        Padding="14,11"
                                        CornerRadius="5"
                                        Background="{StaticResource CanvasBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        DragEnter="Input_DragEnter"
                                        DragLeave="Input_DragLeave"
                                        Drop="Input_Drop">
                                    <StackPanel>
                                        <TextBlock Text="Drop an EXE or DLL here"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontSize="12.5" />
                                        <Button Content="Choose file"
                                                Click="BrowseInput_Click"
                                                Margin="0,9,0,0"
                                                HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="InputNameText"
                                           Text="No file selected"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="{StaticResource DividerBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="18,13">
                            <StackPanel>
                                <TextBlock Text="Target" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="TargetText"
                                           Text="No input loaded"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           Margin="0,6,0,2" />
                                <TextBlock x:Name="TargetStatusText"
                                           Visibility="Collapsed"
                                           FontSize="12"
                                           FontWeight="Medium"
                                           Margin="0,0,0,4" />
                                <TextBlock x:Name="TargetDetailText"
                                           Text="Select a file to inspect target compatibility."
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           LineHeight="17" />
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="{StaticResource DividerBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="18,13">
                            <StackPanel>
                                <TextBlock Text="Profile" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="Preset"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           Margin="0,8,0,4" />
                                <ComboBox x:Name="PresetCombo" SelectionChanged="PresetCombo_SelectionChanged" />
                                <TextBlock x:Name="PresetHintText"
                                           Text="Explicit setting overrides take precedence."
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="11.5"
                                           TextWrapping="Wrap"
                                           Margin="0,6,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="Load config" Click="LoadConfig_Click" Margin="0,0,8,0" />
                                    <Button Content="Save config" Click="SaveConfig_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="18,13">
                            <TextBlock Text="CLI worker" Style="{StaticResource SectionTitle}" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="WorkerPathTextBox"
                                         Tag="Path to rampart.exe"
                                         TextChanged="WorkerPath_TextChanged" />
                                <Button Grid.Column="2" Content="Browse" Click="BrowseWorker_Click" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right pane: settings table and selected-row description -->
            <Grid Grid.Column="1" Background="{StaticResource CanvasBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="18,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="250" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Protection settings" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            <TextBlock x:Name="SettingsCountText"
                                       Text="Loading..."
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="12"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBox Grid.Column="1"
                                 x:Name="SettingsSearchTextBox"
                                 Tag="Filter settings..."
                                 TextChanged="SettingsSearch_TextChanged"
                                 ToolTip="Filter by name, identifier, group, or description" />
                    </Grid>
                </Border>

                <DataGrid Grid.Row="1"
                          x:Name="SettingsGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0"
                          BorderThickness="0"
                          Background="{StaticResource CanvasBrush}"
                          RowBackground="{StaticResource CanvasBrush}"
                          Foreground="{StaticResource TextBrush}"
                          HorizontalGridLinesBrush="{StaticResource DividerBrush}"
                          VerticalGridLinesBrush="Transparent"
                          SelectionUnit="FullRow"
                          SelectionMode="Single"
                          IsReadOnly="False">
                    <DataGrid.Resources>
                        <!-- Keep row selection in the dark palette even when focus leaves the grid. -->
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{StaticResource TintHoverColor}" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{StaticResource TintColor}" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{StaticResource TextColor}" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{StaticResource TextColor}" />
                    </DataGrid.Resources>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="Padding" Value="14,9" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridColumnHeader">
                                        <Grid>
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"
                                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                            </Border>
                                            <Thumb x:Name="PART_RightHeaderGripper"
                                                   HorizontalAlignment="Right"
                                                   Width="5"
                                                   Cursor="SizeWE"
                                                   Opacity="0" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource TintHoverBrush}" />
                                </Trigger>
                                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                    <Setter Property="Opacity" Value="0.52" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Setter Property="Padding" Value="14,8" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Protection" Width="2.1*" MinWidth="220" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                                        <TextBlock Text="{Binding Id}"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="11"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="1.0*" MinWidth="120" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Level" Width="140" MinWidth="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding LevelChoices}"
                                              SelectedItem="{Binding SelectedLevel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding IsAvailable}"
                                              MinWidth="112" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Availability" Binding="{Binding Availability}" Width="1.05*" MinWidth="165" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    <Setter Property="FontSize" Value="12" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="2"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource DividerBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="18,10">
                    <TextBlock x:Name="SettingDescriptionText"
                               Text="Select a setting to view its description."
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Grid>

        <!-- Output and execution bar -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Output"
                               Foreground="{StaticResource MutedBrush}"
                               FontWeight="Medium"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0" />
                    <TextBox Grid.Column="1"
                             x:Name="OutputPathTextBox"
                             Tag="Protected output path"
                             VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="Browse" Click="BrowseOutput_Click" Margin="8,0,0,0" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <CheckBox x:Name="OverwriteCheckBox"
                                  Content="Replace existing"
                                  Foreground="{StaticResource MutedBrush}"
                                  FontSize="12.5"
                                  VerticalAlignment="Center"
                                  Margin="0,0,14,0" />
                        <TextBlock x:Name="ActionHintText"
                                   Text="Choose a file"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />
                        <Button x:Name="CancelButton"
                                Content="Cancel"
                                Click="Cancel_Click"
                                IsEnabled="False"
                                Visibility="Collapsed"
                                Style="{StaticResource DangerButton}"
                                Margin="0,0,8,0" />
                        <Button x:Name="ProtectButton"
                                Content="Protect"
                                Click="Protect_Click"
                                ToolTipService.ShowOnDisabled="True"
                                Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="260" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="LogTextBox"
                             Height="68"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="11.5"
                             Text="Ready." />
                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <ProgressBar x:Name="WorkerProgress"
                                     IsIndeterminate="True"
                                     Visibility="Collapsed" />
                        <TextBlock x:Name="RunStateText"
                                   Text="Choose a file to protect"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   TextAlignment="Right"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
