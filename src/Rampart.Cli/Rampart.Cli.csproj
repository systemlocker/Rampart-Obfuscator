<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Rampart.Cli</RootNamespace>
    <AssemblyName>rampart</AssemblyName>
    <PackageId>rampart</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>rampart</ToolCommandName>
    <Description>Command-line interface for protecting and inspecting Windows x64 PE files with Rampart.</Description>
    <PackageTags>cli;pe;obfuscation;protection;windows;x64</PackageTags>
    <RollForward>LatestMajor</RollForward>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rampart.Core\Rampart.Core.csproj" />
  </ItemGroup>

  <!-- Portable symbols can expose local build paths and are not needed to run the packaged tool. -->
  <Target Name="ExcludeSymbolsFromToolPackage"
          BeforeTargets="PackTool"
          Condition="'$(PackAsTool)' == 'true'">
    <ItemGroup>
      <_ToolPackageSymbols Include="$(PublishDir)/**/*.pdb" />
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
    <Delete Files="@(_ToolPackageSymbols)" />
  </Target>

</Project>
